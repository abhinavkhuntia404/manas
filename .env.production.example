# ==============================================================================
# MANAS Production Environment Variables Configuration Template
# ==============================================================================

# Application Configuration
APP_NAME=MANAS
APP_VERSION=1.0.0
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
SECRET_KEY=generate_a_cryptographically_secure_random_string_here_for_prod

# PostgreSQL Database Configuration
POSTGRES_USER=manas_admin
POSTGRES_PASSWORD=replace_with_a_secure_long_password
POSTGRES_DB=manas_prod
DATABASE_URL=postgresql://manas_admin:replace_with_a_secure_long_password@db:5432/manas_prod

# Rate Limiting & Concurrency
API_RATE_LIMIT=120/minute
MAX_CONCURRENT_JOBS=8

# Statistical Analysis Parameters (Scientific Defaults)
MIN_GROUP_SIZE=5
FDR_ALPHA=0.05
BOOTSTRAP_N=1000
DEFAULT_RANDOM_SEED=42

# Frontend Ingress (used during container build)
NEXT_PUBLIC_API_URL=/api
